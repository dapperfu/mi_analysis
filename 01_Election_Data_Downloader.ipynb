   "source": [
    "results_url = \"https://int.nyt.com/applications/elections/2020/data/api/2020-03-10/michigan/president/democrat.json\""


## 2024 Presidential Results

# API endpoint for 2024 Michigan presidential results
results_url = "https://static01.nyt.com/elections-assets/2024/data/2024-11-05/results-michigan-president.json"

try:
    response = requests.get(results_url)
    if response.status_code == 200:
        results = json.loads(response.text)
        with open("2024.president.json", "w") as fp:
            json.dump(results, fp)
        print("2024 presidential data downloaded via API")
    else:
        print(f"API request failed with status code: {response.status_code}")
        # Fallback to scraping the interactive page
        results_url = "https://www.nytimes.com/interactive/2024/11/05/us/elections/results-michigan-president.html"
        with webdriver.Firefox() as browser:
            browser.get(results_url)
            # Try to extract the election data from the page
            try:
                eln_races = browser.execute_script("return eln_races")
                if eln_races:
                    with open("2024.president.json", "w") as fp:
                        json.dump(eln_races, fp)
                    print("2024 presidential data scraped from interactive page")
                else:
                    print("Could not find eln_races variable on page")
            except Exception as e:
                print(f"Error scraping page: {e}")
except Exception as e:
    print(f"Error downloading 2024 data: {e}")
